generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id          String   @id @default(cuid())
  shop        String
  name        String
  link        String?
  address     String
  address2    String?
  city        String
  state       String
  zip         String
  country     String   @default("United States")
  phone       String?
  lat         Float?
  lng         Float?
  notes       String?
  createdAt   DateTime @default(now())
}

model StoreSubmission {
  id            String   @id @default(cuid())
  shop          String
  storeName     String
  storeType     String
  contactName   String
  contactEmail  String
  contactPhone  String?
  address       String
  address2      String?
  city          String
  state         String
  zip           String
  country       String   @default("United States")
  website       String?
  lat           Float?
  lng           Float?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes         String?
  adminNotes    String?  // Internal notes for admin review
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavedView {
  id          String   @id @default(cuid())
  shop        String
  name        String
  filters     String   // JSON string of filter values
  isDefault   Boolean  @default(false) // Pre-populated system views
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([shop, name], name: "shop_name")
  @@index([shop])
}

model StoreAnalyticsEvent {
  id              String   @id @default(cuid())
  shop            String
  sessionId       String
  eventType       String   // 'search', 'store_view', 'store_contact', 'radius_change'
  
  // Search event data
  searchQuery     String?
  resultsCount    Int?
  radius          Float?
  radiusUnit      String?  // 'miles', 'km'
  
  // Store event data
  storeId         String?
  storeName       String?
  viewType        String?  // 'list', 'map_marker' (for store_view)
  distanceFromUser Float?  // Distance in user's preferred unit
  rankInResults   Int?     // Position in search results (1-based)
  
  // Contact event data
  contactType     String?  // 'phone_click', 'website_click' (for store_contact)
  
  // Radius change event data
  oldRadius       Float?
  newRadius       Float?
  
  // Timestamps
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())
  
  @@index([shop])
  @@index([eventType])
  @@index([timestamp])
  @@index([sessionId])
  @@index([storeId])
  @@index([searchQuery])
}

model StoreAnalyticsAggregate {
  id                String   @id @default(cuid())
  shop              String
  periodType        String   // 'day', 'week', 'month'
  periodStart       DateTime
  
  // Search metrics
  totalSearches     Int      @default(0)
  uniqueSessions     Int      @default(0)
  
  // Top data (JSON arrays)
  topSearchQueries   Json?    // [{"query": "Colorado Springs", "count": 45}, ...]
  topStores         Json?    // [{"storeId": "123", "name": "Store Name", "views": 234, "contacts": 89}, ...]
  
  // Contact metrics
  totalContacts     Int      @default(0) // Total phone + website clicks
  
  updatedAt         DateTime @updatedAt
  
  @@unique([shop, periodType, periodStart])
  @@index([shop, periodType, periodStart])
}