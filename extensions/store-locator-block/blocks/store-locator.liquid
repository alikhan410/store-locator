{% comment %}
  Store Locator Block
  This block uses the app proxy route /apps/storetrail/maps-loader for Google Maps API
  and /apps/storetrail/locations for store search functionality
{% endcomment %}
<link href="{{ 'base.css' | asset_url }}" rel="stylesheet">
<link href="{{ 'components.css' | asset_url }}" rel="stylesheet">
<link href="{{ 'layout.css' | asset_url }}" rel="stylesheet">
<link href="{{ 'form.css' | asset_url }}" rel="stylesheet">
<link href="{{ 'responsive.css' | asset_url }}" rel="stylesheet">

<script src="{{ 'haversineDistance.js' | asset_url }}" defer></script>
<script src="{{ 'analytics-tracking.js' | asset_url }}" defer></script>
<script
  src="/apps/storetrail/maps-loader"
  async
  defer
></script>
<script>
  window.radiusUnit = '{{ block.settings.radius_unit }}';
</script>

<div class="store-locator-wrapper">
  {% if block.settings.show_heading %}
    <h2
      style="--heading-align: {{ block.settings.heading_horizontal_alignment }};"
      class="store-locator-heading"
    >
      {{ block.settings.heading }}
    </h2>
  {% endif %}
  {% if block.settings.show_content %}
    <p
      style="--content-align: {{ block.settings.content_horizontal_alignment }};"
      class="store-locator-content"
    >
      {{ block.settings.content }}
    </p>
  {% endif %}

  <!-- Top Input Bar for autocomplete api -->
  <form class="store-locator-form" onsubmit="return false;">
    <div class="input-container">
      <input
        type="text"
        id="user-location"
        placeholder="{{ block.settings.search_bar_text }}"
      >
    </div>

    <select id="radius" data-unit="{{ block.settings.radius_unit }}">
      <option value="5">5 {{ block.settings.radius_unit }}</option>
      <option value="10">10 {{ block.settings.radius_unit }}</option>
      <option value="25">25 {{ block.settings.radius_unit }}</option>
      <option value="50">50 {{ block.settings.radius_unit }}</option>
      <option value="100">100 {{ block.settings.radius_unit }}</option>
      <option value="1000">1000 {{ block.settings.radius_unit }}</option>
    </select>

    <button
      style="
        --search-btn-bg: {{ block.settings.search_btn_background }};
        --search-btn-hover-bg: {{ block.settings.search_btn_hover }};
        --search-btn-text: {{ block.settings.search_btn_text_color }};
        --search-btn-border-radius: {{ block.settings.search_btn_border_radius }}px;
      "
      type="submit"
      id="search-btn"
      class="search-btn"
    >
      Search
    </button>
  </form>

  <!-- Grid Layout -->
  <div class="store-locator-grid">
    <!-- Store Results -->
    <div id="search-results" class="store-locator-results">
      <p>Search to see nearby stores...</p>
    </div>

    <!-- Leaflet Map -->
    <div id="store-map" class="store-locator-map"></div>
  </div>
</div>

<script>
  let locationInput;
  let resultsEl;
  let searchBtn;
  let radiusSelect;
  let suggestionBox;
  let map;
  let markers = [];
  let userCoords;
  
  // Analytics: Store current stores for reference
  let currentStores = [];

  const formatName = (name) => name.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
  const toTitleCase = (str) => {
    if (!str) return '';
    return str
      .toLowerCase()
      .split(' ')
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
  };

  // Analytics tracking functions are now in analytics-tracking.js
  // Access via window.StoreLocatorAnalytics

  function updateMapAndList(userCoords, stores) {
    resultsEl.innerHTML = '';
    
    // Store current stores data for analytics
    currentStores = stores;

    if (markers.length) {
      markers.forEach((m) => m.setMap(null));
      markers = [];
    }

    const boundsObj = new google.maps.LatLngBounds();

    if (stores.length === 0) {
      resultsEl.innerHTML = '<p>No stores found within selected radius.</p>';
      return;
    }

    stores.forEach((store, index) => {
      const marker = new google.maps.Marker({
        position: { lat: store.lat, lng: store.lng },
        map,
        title: store.name,
      });

      //Converting km into miles if the unit = miles
      const convertedDistance = window.radiusUnit === 'miles' ? (store.distance / 1.60934).toFixed(2) : store.distance;

      const infoWindow = new google.maps.InfoWindow({
        content: `<b>${store.name}</b><br>${store.address}<br>${convertedDistance} ${window.radiusUnit}`,
      });

      // Analytics: Track map marker click
      marker.addListener('click', () => {
        infoWindow.open(map, marker);
        if (window.StoreLocatorAnalytics) {
          window.StoreLocatorAnalytics.trackStoreView(store, 'map_marker', index + 1);
        }
      });

      markers.push(marker);
      boundsObj.extend(marker.getPosition());

      // Create unique ID for store result element
      const storeResultId = `store-result-${index}`;

      resultsEl.innerHTML += `
        <div class="store-result" id="${storeResultId}" data-lat="${store.lat}" data-lng="${store.lng}" data-store-index="${index}">
          <div class="store-name">${formatName(store.name)}</div>
          <div class="store-address">
            ${toTitleCase(store.address)}${store.address2 ? ', ' + toTitleCase(store.address2) : ''}, 
            ${toTitleCase(store.city)}, ${store.state.toUpperCase()} ${store.zip}
          </div>
          ${store.phone ? `<div class="store-phone"><a href="tel:${store.phone}" class="store-phone-link" data-store-index="${index}">${store.phone}</a></div>` : ''}
          ${
            store.link
              ? `<div class="store-link"><a href="${store.link}" class="store-website-link" data-store-index="${index}" target="_blank" rel="noopener noreferrer">Store Website</a></div>`
              : ''
          }
          <div class="store-distance">${convertedDistance} ${window.radiusUnit} away</div>
        </div>
      `;
    });
    
    // Analytics: Add event listeners for store interactions
    const storeEls = document.querySelectorAll('.store-result');
    storeEls.forEach((storeEl) => {
      const storeIndex = parseInt(storeEl.dataset.storeIndex);
      const store = stores[storeIndex];
      
      if (!store) return;

      // Track store list click
      storeEl.addEventListener('click', (e) => {
        // Don't track if clicking on phone or website links (they have their own tracking)
        if (e.target.closest('.store-phone-link, .store-website-link')) {
          return;
        }

        const lat = parseFloat(storeEl.dataset.lat);
        const lng = parseFloat(storeEl.dataset.lng);

        if (!isNaN(lat) && !isNaN(lng)) {
          map.setCenter({ lat, lng });
          map.setZoom(19);
        }

        if (window.matchMedia('(max-width: 768px)').matches) {
          document.getElementById('store-map').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Track store view from list
        if (window.StoreLocatorAnalytics) {
          window.StoreLocatorAnalytics.trackStoreView(store, 'list', storeIndex + 1);
        }
      });
    });

    map.fitBounds(boundsObj);
  }

  function initMap() {
    const mapEl = document.getElementById('store-map');
    map = new google.maps.Map(mapEl, {
      center: { lat: 37.0902, lng: -95.7129 },
      zoom: 4,
    });

    setupSearchHandlers();
  }

  function setupSearchHandlers() {
    locationInput = document.getElementById('user-location');
    resultsEl = document.getElementById('search-results');
    searchBtn = document.getElementById('search-btn');
    radiusSelect = document.getElementById('radius');
    suggestionBox = document.createElement('div');
    const mapEl = document.getElementById('store-map');

    map = new google.maps.Map(mapEl, {
      center: { lat: 37.0902, lng: -95.7129 },
      zoom: 4,
    });

    // Analytics: Track phone and website clicks using event delegation (added once)
    resultsEl.addEventListener('click', (e) => {
      if (!window.StoreLocatorAnalytics) return;

      const storeIndex = e.target.closest('[data-store-index]')?.getAttribute('data-store-index');
      if (storeIndex === null || storeIndex === undefined) return;

      const store = currentStores[parseInt(storeIndex)];
      if (!store) return;

      // Track phone clicks
      if (e.target.classList.contains('store-phone-link')) {
        window.StoreLocatorAnalytics.trackStoreContact(store, 'phone_click');
      }
      // Track website clicks
      else if (e.target.classList.contains('store-website-link')) {
        window.StoreLocatorAnalytics.trackStoreContact(store, 'website_click');
      }
    });

    const autocomplete = new google.maps.places.Autocomplete(locationInput, {
      types: ['geocode'],
      componentRestrictions: { country: 'us' },
    });

    autocomplete.addListener('place_changed', () => {
      const place = autocomplete.getPlace();
      if (!place.geometry || !place.geometry.location) return;

      userCoords = {
        lat: place.geometry.location.lat(),
        lng: place.geometry.location.lng(),
      };

      const radiusValue = parseInt(radiusSelect.value, 10);
      const radiusKm = window.radiusUnit === 'miles' ? radiusValue * 1.60934 : radiusValue;
      console.log('radiusValue is: ', radiusValue, ' and radiusKm is: ', radiusKm);

      resultsEl.innerHTML = `
        <div class="store-loading">
          <div class="spinner">&nbsp;</div>
        </div>
      `;

      fetch(
        `/apps/storetrail/locations?lat=${userCoords.lat}&lng=${userCoords.lng}&radius=${radiusKm}&shop={{ shop.domain }}`
      )
        .then((res) => res.json())
        .then((data) => {
          updateMapAndList(userCoords, data.stores);
          // Track the search from autocomplete
          const query = locationInput.value.trim();
          if (window.StoreLocatorAnalytics) {
            window.StoreLocatorAnalytics.trackSearch(query, data.stores ? data.stores.length : 0, radiusValue);
          }
        });
    });

    searchBtn.addEventListener('click', () => {
      suggestionBox.innerHTML = '';
      const radiusValue = parseInt(radiusSelect.value, 10);
      const radiusKm = window.radiusUnit === 'miles' ? radiusValue * 1.60934 : radiusValue;
      console.log('radiusValue is: ', radiusValue, ' and radiusKm is: ', radiusKm);

      const query = locationInput.value.trim();

      if (!query || query.length < 3) {
        resultsEl.innerHTML = '<p>Please enter a location to search.</p>';
        return;
      }

      resultsEl.innerHTML = `
        <div class="store-loading">
          <div class="spinner">&nbsp;</div>
        </div>
      `;

      console.log('Search button clicked, query:', query);
      fetch(`/apps/storetrail/geocode?address=${encodeURIComponent(query)}`)
        .then((res) => {
          console.log('Geocode response status:', res.status);
          return res.json();
        })
        .then((geo) => {
          console.log('Geocode result:', geo);
          if (!geo.lat || !geo.lng) {
            resultsEl.innerHTML = '<p>Location not found. Try another search.</p>';
            return;
          }

          userCoords = { lat: geo.lat, lng: geo.lng };
          console.log('Fetching locations for:', userCoords);

          fetch(
            `/apps/storetrail/locations?lat=${userCoords.lat}&lng=${userCoords.lng}&radius=${radiusKm}&shop={{ shop.domain }}`
          )
            .then((res) => {
              console.log('Locations response status:', res.status);
              return res.json();
            })
            .then((data) => {
              console.log('Search results received:', data);
              updateMapAndList(userCoords, data.stores);
              // Track the search
              if (window.StoreLocatorAnalytics) {
                window.StoreLocatorAnalytics.trackSearch(query, data.stores ? data.stores.length : 0, radiusValue);
              }
            })
            .catch((error) => {
              console.error('Error fetching locations:', error);
            });
        })
            .catch((error) => {
              console.error('Error in geocode fetch:', error);
              resultsEl.innerHTML = '<p>Something went wrong. Try again later.</p>';
            });
    });

    // Analytics: Track radius changes (only if there's an active search)
    radiusSelect.addEventListener('change', () => {
      if (window.StoreLocatorAnalytics) {
        const newRadius = parseInt(radiusSelect.value, 10);
        const currentRadius = window.StoreLocatorAnalytics.getCurrentRadius();
        if (currentRadius !== null && currentRadius !== newRadius) {
          window.StoreLocatorAnalytics.trackRadiusChange(currentRadius, newRadius);
        }
      }
    });
  }
</script>

{% comment %} https://shopify.dev/docs/storefronts/themes/architecture/settings/input-settings {% endcomment %}
